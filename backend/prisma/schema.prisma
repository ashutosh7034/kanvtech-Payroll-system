generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum EmploymentType {
  PERMANENT
  PROBATIONARY
  CONTRACTUAL
  CONSULTANT
  INTERN
  PART_TIME
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  CONFIRMED
  NOTICE_PERIOD
  SUSPENDED
  EXITED
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_STATUTORY
}

enum CalculationMode {
  FIXED_AMOUNT
  PERCENTAGE_OF_COMPONENT
  FORMULA_EXPRESSION
}

enum PunchSource {
  WEB
  BIOMETRIC
  MOBILE
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WEEKLY_OFF
  HOLIDAY
  ON_LEAVE
}

enum LeaveDurationType {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
  CORRECTION_REQUESTED
  PAID
}

enum CorporatePayrollStatus {
  DRAFT
  VALIDATED
  CALCULATED
  REVIEWED
  APPROVED
  PAYMENT_READY
  PAID
}

enum PaymentMethod {
  NEFT
  RTGS
  IMPS
  CHEQUE
  UPI
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MOBILE
  MONITOR
  ACCESS_CARD
  VEHICLE
  OTHER
}

enum AssetCondition {
  NEW
  GOOD
  DAMAGED
  LOST
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CandidateStage {
  APPLIED
  SHORTLISTED
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  OFFER_EXTENDED
  HIRED
  REJECTED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ReviewRating {
  UNSATISFACTORY
  NEEDS_IMPROVEMENT
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING
}

// ==========================================
// 2. MULTI-COMPANY & ORGANIZATION ENTITIES
// ==========================================

model Company {
  id              String      @id @default(uuid())
  code            String      @unique
  name            String
  brandName       String?
  legalName       String
  cinNumber       String?
  gstin           String?
  panNumber       String?
  tanNumber       String?
  pfEstablishmentCode String?
  esicCode        String?
  ptrcNumber      String?
  contactEmail    String
  contactPhone    String?
  website         String?
  currency        String      @default("INR")
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  branches        Branch[]
  departments     Department[]
  designations    Designation[]
  jobBands        JobBand[]
  costCenters     CostCenter[]
  employees       Employee[]
  users           User[]
  payrollPeriods  PayrollPeriod[]
  payrollRuns     CorporatePayrollRun[]
  salaryComponents SalaryComponent[]
  salaryTemplates SalaryTemplate[]
  shiftPolicies   ShiftPolicy[]
  leavePolicies   LeavePolicy[]
  statutoryConfig StatutoryConfig?
  assets          CompanyAsset[]
  jobOpenings     JobOpening[]
  projects        Project[]
  performanceCycles PerformanceCycle[]
  trainingCourses TrainingCourse[]
  expenseCategories ExpenseCategory[]
  loanTypes       LoanType[]
  helpDeskCategories HelpDeskCategory[]
  visitorPasses   VisitorPass[]
  auditLogs       AuditLog[]
  customFields    CustomFieldDefinition[]
  notifications   InAppNotification[]
  orgUnits        OrgUnit[]
  employmentCategories EmploymentCategory[]
  jobPositions    JobPosition[]
}

model Branch {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  state           String
  city            String
  address         String?
  pinCode         String?
  isHeadquarters  Boolean     @default(false)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employees       Employee[]
  orgUnits        OrgUnit[]

  @@unique([companyId, code])
}

model Department {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employees       Employee[]
  jobOpenings     JobOpening[]
  jobPositions    JobPosition[]

  @@unique([companyId, code])
}

model Designation {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employees       Employee[]
  jobOpenings     JobOpening[]
  jobPositions    JobPosition[]

  @@unique([companyId, code])
}

model JobBand {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  minCtc          Decimal     @default(0) @db.Decimal(18, 2)
  maxCtc          Decimal     @default(0) @db.Decimal(18, 2)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())

  employees       Employee[]
  jobPositions    JobPosition[]

  @@unique([companyId, code])
}

model CostCenter {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())

  employees       Employee[]

  @@unique([companyId, code])
}

model OrgUnit {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  code            String
  name            String
  description     String?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, code])
}

model EmploymentCategory {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  description     String?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, code])
}

model JobPosition {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId   String?
  designation     Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  gradeId         String?
  grade           JobBand?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  code            String
  title           String
  description     String?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, code])
}

// ==========================================
// 3. USERS, ROLES & AUDITING
// ==========================================

model User {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String?     @unique
  employee        Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  username        String      @unique
  email           String      @unique
  passwordHash    String
  fullName        String
  active          Boolean     @default(true)
  activeSessionId String?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userRoles       UserRole[]
  auditLogs       AuditLog[]
  ticketComments  TicketComment[]
  notifications   InAppNotification[]
}

model Role {
  id              String      @id @default(uuid())
  name            String      @unique
  description     String?
  permissions     String[]    @default([])
  createdAt       DateTime    @default(now())

  userRoles       UserRole[]
}

model UserRole {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())

  @@unique([userId, roleId])
}

model AuditLog {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action          String
  entityType      String
  entityId        String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime    @default(now())

  @@index([companyId, action])
  @@index([createdAt])
}

// ==========================================
// 4. CORE HRIS & EMPLOYEE MASTER
// ==========================================

model Employee {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id])
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id])
  designationId   String
  designation     Designation       @relation(fields: [designationId], references: [id])
  jobBandId       String?
  jobBand         JobBand?          @relation(fields: [jobBandId], references: [id])
  costCenterId    String?
  costCenter      CostCenter?       @relation(fields: [costCenterId], references: [id])
  managerId       String?
  manager         Employee?         @relation("ReportingManager", fields: [managerId], references: [id])
  directReports   Employee[]        @relation("ReportingManager")

  employeeCode    String            @unique
  firstName       String
  lastName        String
  workEmail       String            @unique
  personalEmail   String?
  phone           String?
  dateOfBirth     DateTime?
  gender          Gender            @default(MALE)
  maritalStatus   String?
  bloodGroup      String?
  emergencyContactName String?
  emergencyContactPhone String?
  addressLine1    String?
  city            String?
  state           String?
  pinCode         String?

  employmentType  EmploymentType    @default(PERMANENT)
  status          EmploymentStatus  @default(PROBATION)
  workMode        WorkMode          @default(OFFICE)
  dateOfJoining   DateTime
  probationDays   Int               @default(90)
  confirmationDate DateTime?
  noticePeriodDays Int              @default(60)
  exitDate        DateTime?

  jobPostCode     String?
  unit            String?
  category        String?
  project         String?

  panNumber       String?
  uanNumber       String?
  pfNumber        String?
  esicNumber      String?
  aadhaarMasked   String?

  bankName        String?
  bankAccountNumber String?
  ifscCode        String?
  bankBranch      String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User?
  documents       EmployeeDocument[]
  timeline        EmploymentTimeline[]
  salaryStructure EmployeeSalaryStructure?
  salaryRevisions EmployeeSalaryRevision[]
  payrollPolicy   EmployeePayrollPolicy?
  punches         AttendancePunch[]
  dailyAttendance DailyAttendance[]
  regularizations AttendanceRegularization[]
  leaveBalances   EmployeeLeaveBalance[]
  leaveRequests   LeaveRequest[]
  payrollSlips    CorporatePayrollSlip[]
  expenseClaims   ExpenseClaim[]
  travelRequests  TravelRequest[]
  timesheetEntries TimesheetEntry[]
  projectAllocations ProjectAllocation[]
  goals           EmployeeGoal[]
  reviews         PerformanceReview[]
  nominations     TrainingNomination[]
  loans           EmployeeLoan[]
  allocatedAssets AssetAllocation[]
  helpDeskTickets HelpDeskTicket[]
  resignation     Resignation?
  fnfSettlement   FnfSettlement?
  onboardingTasks EmployeeOnboardingTask[]
  shiftRosters    ShiftRoster[]
  taxDeclarations EmployeeTaxDeclaration[]
  customFieldValues EmployeeCustomFieldValue[]

  @@index([companyId, status])
  @@index([departmentId])
  @@index([branchId])
}

model EmployeeDocument {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category        String
  fileName        String
  fileUrl         String
  expiryDate      DateTime?
  isVerified      Boolean     @default(false)
  uploadedAt      DateTime    @default(now())
}

model EmploymentTimeline {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventType       String
  title           String
  description     String?
  effectiveDate   DateTime
  recordedBy      String?
  createdAt       DateTime    @default(now())
}

// ==========================================
// 5. RECRUITMENT & ATS
// ==========================================

model JobOpening {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  designationId   String
  designation     Designation @relation(fields: [designationId], references: [id])
  title           String
  openingsCount   Int         @default(1)
  minExperience   Int         @default(0)
  budgetMin       Decimal     @default(0) @db.Decimal(18, 2)
  budgetMax       Decimal     @default(0) @db.Decimal(18, 2)
  description     String?
  status          String      @default("OPEN")
  createdAt       DateTime    @default(now())

  applications    JobApplication[]
}

model Candidate {
  id              String      @id @default(uuid())
  fullName        String
  email           String      @unique
  phone           String?
  currentCompany  String?
  currentCtc      Decimal?    @db.Decimal(18, 2)
  expectedCtc     Decimal?    @db.Decimal(18, 2)
  noticePeriodDays Int?
  resumeUrl       String?
  createdAt       DateTime    @default(now())

  applications    JobApplication[]
}

model JobApplication {
  id              String          @id @default(uuid())
  jobOpeningId    String
  jobOpening      JobOpening      @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage           CandidateStage  @default(APPLIED)
  notes           String?
  appliedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  interviews      Interview[]
  offer           JobOffer?

  @@unique([jobOpeningId, candidateId])
}

model Interview {
  id              String          @id @default(uuid())
  jobApplicationId String
  jobApplication  JobApplication  @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  roundName       String
  scheduledAt     DateTime
  interviewerName String
  interviewerEmail String?
  score           Int?
  feedback        String?
  status          String          @default("SCHEDULED")
}

model JobOffer {
  id              String          @id @default(uuid())
  jobApplicationId String         @unique
  jobApplication  JobApplication  @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  offeredCtc      Decimal         @db.Decimal(18, 2)
  joiningDate     DateTime
  offerStatus     OfferStatus     @default(DRAFT)
  offerLetterUrl  String?
  createdAt       DateTime        @default(now())
}

// ==========================================
// 6. ONBOARDING
// ==========================================

model OnboardingChecklist {
  id              String      @id @default(uuid())
  title           String
  category        String
  defaultDueDays  Int         @default(7)
  createdAt       DateTime    @default(now())
}

model EmployeeOnboardingTask {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  category        String
  dueDate         DateTime
  isCompleted     Boolean     @default(false)
  completedAt     DateTime?
}

// ==========================================
// 7. COMPENSATION & CTC BUILDER
// ==========================================

model SalaryComponent {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code              String
  name              String
  type              ComponentType
  category          String          @default("FIXED_EARNING")
  calculationMode   CalculationMode @default(FIXED_AMOUNT)
  formulaExpression String?
  baseComponentCode String?
  percentageValue   Decimal?        @db.Decimal(7, 4)
  fixedAmount       Decimal?        @db.Decimal(18, 2)
  minLimit          Decimal?        @db.Decimal(18, 2)
  maxLimit          Decimal?        @db.Decimal(18, 2)
  roundPolicy       String          @default("ROUND_HALF_UP")
  isTaxable         Boolean         @default(true)
  isPfGross         Boolean         @default(false)
  isEsicGross       Boolean         @default(false)
  isPtGross         Boolean         @default(false)
  affectsGross      Boolean         @default(true)
  affectsNet        Boolean         @default(true)
  affectsCtc        Boolean         @default(true)
  payslipVisibility Boolean         @default(true)
  active            Boolean         @default(true)
  displayOrder      Int             @default(0)
  createdAt         DateTime        @default(now())

  templateLines     SalaryTemplateLine[]
  structureLines    EmployeeSalaryLine[]

  @@unique([companyId, code])
}

model SalaryTemplate {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String?
  name            String
  description     String?
  version         Int             @default(1)
  isDefault       Boolean         @default(false)
  active          Boolean         @default(true)
  effectiveFrom   DateTime        @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines           SalaryTemplateLine[]
  structures      EmployeeSalaryStructure[]

  @@unique([companyId, code])
}

model SalaryTemplateLine {
  id                String          @id @default(uuid())
  templateId        String
  template          SalaryTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  componentId       String
  component         SalaryComponent @relation(fields: [componentId], references: [id])
  calculationMode   CalculationMode
  percentageOfBasic Decimal?        @db.Decimal(7, 4)
  percentageValue   Decimal?        @db.Decimal(7, 4)
  fixedAmount       Decimal?        @db.Decimal(18, 2)
  formulaExpression String?
  baseComponentCode String?
  displayOrder      Int             @default(0)
}

model EmployeeSalaryStructure {
  id              String          @id @default(uuid())
  employeeId      String          @unique
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId      String?
  template        SalaryTemplate? @relation(fields: [templateId], references: [id])
  annualCtc       Decimal         @db.Decimal(18, 2)
  monthlyGross    Decimal         @db.Decimal(18, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  version         Int             @default(1)
  revisionReason  String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines           EmployeeSalaryLine[]
}

model EmployeeSalaryLine {
  id              String          @id @default(uuid())
  structureId     String
  structure       EmployeeSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentId     String
  component       SalaryComponent @relation(fields: [componentId], references: [id])
  monthlyAmount   Decimal         @db.Decimal(18, 2)
  annualAmount    Decimal         @db.Decimal(18, 2)
}

model EmployeeSalaryRevision {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  annualCtc       Decimal         @db.Decimal(18, 2)
  monthlyGross    Decimal         @db.Decimal(18, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  revisionReason  String?
  approvedBy      String?
  snapshot        Json
  createdAt       DateTime        @default(now())

  @@index([employeeId, effectiveFrom])
}

model EmployeePayrollPolicy {
  id              String          @id @default(uuid())
  employeeId      String          @unique
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pfApplicable    Boolean         @default(true)
  pfStatus        String          @default("APPLICABLE")
  pfWageBasis     String          @default("CEILING_15000")
  pfNumber        String?
  uanNumber       String?
  esiApplicable   Boolean         @default(false)
  esiStatus       String          @default("EXEMPT_OVER_CEILING")
  esiNumber       String?
  ptApplicable    Boolean         @default(true)
  ptState         String          @default("Maharashtra")
  taxRegime       String          @default("NEW")
  tdsMonthlyOverride Decimal?     @db.Decimal(18, 2)
  paymentMode     PaymentMethod   @default(NEFT)
  payrollFrequency String         @default("MONTHLY")
  effectiveFrom   DateTime        @default(now())
  effectiveTo     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  exceptionRemarks String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ==========================================
// 8. ATTENDANCE & SHIFTS
// ==========================================

model ShiftPolicy {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  startTime       String
  endTime         String
  graceMinutes    Int             @default(15)
  halfDayMinutes  Int             @default(240)
  fullDayMinutes  Int             @default(480)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())

  dailyAttendances DailyAttendance[]
  shiftRosters    ShiftRoster[]

  @@unique([companyId, code])
}

model ShiftRoster {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftPolicyId   String
  shiftPolicy     ShiftPolicy     @relation(fields: [shiftPolicyId], references: [id])
  rosterDate      DateTime

  @@unique([employeeId, rosterDate])
}

model AttendancePunch {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punchTime       DateTime
  punchType       String
  source          PunchSource     @default(WEB)
  ipAddress       String?
  deviceCode      String?
  createdAt       DateTime        @default(now())

  @@index([employeeId, punchTime])
}

model DailyAttendance {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  status          AttendanceStatus @default(PRESENT)
  shiftPolicyId   String?
  shiftPolicy     ShiftPolicy?    @relation(fields: [shiftPolicyId], references: [id])
  firstIn         DateTime?
  lastOut         DateTime?
  workingHours    Decimal         @default(0) @db.Decimal(5, 2)
  lateMinutes     Int             @default(0)
  overtimeMinutes Int             @default(0)
  isLocked        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([employeeId, date])
}

model AttendanceRegularization {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate  DateTime
  reasonCode      String
  reasonNotes     String
  requestedStatus AttendanceStatus
  status          RequestStatus   @default(PENDING)
  approvedBy      String?
  actionedAt      DateTime?
  createdAt       DateTime        @default(now())
}

// ==========================================
// 9. LEAVE MANAGEMENT
// ==========================================

model LeavePolicy {
  id                  String          @id @default(uuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                String
  name                String
  annualQuota         Decimal         @db.Decimal(5, 2)
  isPaid              Boolean         @default(true)
  maxCarryForward     Decimal         @default(0) @db.Decimal(5, 2)
  encashable          Boolean         @default(false)
  minAdvanceNoticeDays Int            @default(0)
  maxConsecutiveDays  Int             @default(30)
  allowHalfDay        Boolean         @default(true)
  requiresAttachment  Boolean         @default(false)
  probationAllowed    Boolean         @default(true)
  applicableGender    String          @default("ALL")
  accrualFrequency    String          @default("ANNUAL")
  description         String?
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())

  balances            EmployeeLeaveBalance[]
  requests            LeaveRequest[]

  @@unique([companyId, code])
}

model EmployeeLeaveBalance {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicyId   String
  leavePolicy     LeavePolicy     @relation(fields: [leavePolicyId], references: [id])
  calendarYear    Int
  credited        Decimal         @db.Decimal(5, 2)
  used            Decimal         @default(0) @db.Decimal(5, 2)
  balance         Decimal         @db.Decimal(5, 2)
  updatedAt       DateTime        @updatedAt

  @@unique([employeeId, leavePolicyId, calendarYear])
}

model LeaveRequest {
  id                String            @id @default(uuid())
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicyId     String
  leavePolicy       LeavePolicy       @relation(fields: [leavePolicyId], references: [id])
  applicationNumber String?
  fromDate          DateTime
  toDate            DateTime
  durationType      LeaveDurationType @default(FULL_DAY)
  halfDayPeriod     String?
  totalDays         Decimal           @db.Decimal(4, 2)
  reason            String
  attachmentUrl     String?
  isDraft           Boolean           @default(false)
  status            RequestStatus     @default(PENDING)
  approvedBy        String?
  approverComment   String?
  rejectionReason   String?
  actionedAt        DateTime?
  createdAt         DateTime          @default(now())
}

// ==========================================
// 10. CORPORATE PAYROLL ENGINE (7 STAGES)
// ==========================================

model PayrollPeriod {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodNumber    Int
  name            String
  month           Int
  year            Int
  startDate       DateTime
  endDate         DateTime
  cutoffDate      DateTime
  isLocked        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  runs            CorporatePayrollRun[]

  @@unique([companyId, month, year])
}

model CorporatePayrollRun {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodId        String
  period          PayrollPeriod   @relation(fields: [periodId], references: [id])
  runNumber       String          @unique
  status          CorporatePayrollStatus @default(DRAFT)
  totalEmployees  Int             @default(0)
  totalGross      Decimal         @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal         @default(0) @db.Decimal(18, 2)
  totalNetPay     Decimal         @default(0) @db.Decimal(18, 2)
  totalEmployerCost Decimal       @default(0) @db.Decimal(18, 2)
  validatedBy     String?
  validatedAt     DateTime?
  calculatedAt    DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  paymentReference String?
  validationNotes Json?
  varianceNotes   Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  slips           CorporatePayrollSlip[]
  transitions     CorporatePayrollTransition[]
  emailDispatches PayslipDispatchRecord[]
}

model CorporatePayrollSlip {
  id              String          @id @default(uuid())
  payrollRunId    String
  payrollRun      CorporatePayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id])
  workingDays     Int             @default(30)
  payableDays     Decimal         @db.Decimal(5, 2)
  lopDays         Decimal         @default(0) @db.Decimal(5, 2)
  unpaidDays      Decimal         @default(0) @db.Decimal(5, 2)
  arrearsAmount   Decimal         @default(0) @db.Decimal(18, 2)
  reimbursementAmount Decimal     @default(0) @db.Decimal(18, 2)
  variableEarnings Decimal        @default(0) @db.Decimal(18, 2)
  pfWageBasis     Decimal         @default(0) @db.Decimal(18, 2)
  esiWageBasis    Decimal         @default(0) @db.Decimal(18, 2)
  ptWageBasis     Decimal         @default(0) @db.Decimal(18, 2)
  grossPay        Decimal         @db.Decimal(18, 2)
  deductionsPay   Decimal         @db.Decimal(18, 2)
  netPay          Decimal         @db.Decimal(18, 2)
  employerCost    Decimal         @db.Decimal(18, 2)
  calculationSnapshot Json
  createdAt       DateTime        @default(now())

  items           CorporatePayrollItem[]
  emailDispatches PayslipDispatchRecord[]

  @@unique([payrollRunId, employeeId])
}

model CorporatePayrollItem {
  id              String          @id @default(uuid())
  payrollSlipId   String
  payrollSlip     CorporatePayrollSlip @relation(fields: [payrollSlipId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            ComponentType
  amount          Decimal         @db.Decimal(18, 2)
}

model CorporatePayrollTransition {
  id              String          @id @default(uuid())
  payrollRunId    String
  payrollRun      CorporatePayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  fromStatus      CorporatePayrollStatus
  toStatus        CorporatePayrollStatus
  actorName       String
  actorRole       String
  remarks         String?
  timestamp       DateTime        @default(now())
}

model PayslipDispatchRecord {
  id              String          @id @default(uuid())
  payrollRunId    String
  payrollRun      CorporatePayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollSlipId   String
  payrollSlip     CorporatePayrollSlip @relation(fields: [payrollSlipId], references: [id], onDelete: Cascade)
  employeeId      String
  employeeCode    String
  recipientEmail  String
  status          String          // "DELIVERED" | "FAILED" | "SKIPPED"
  messageId       String?
  attemptCount    Int             @default(1)
  errorDetails    String?
  dispatchedAt    DateTime        @default(now())
  provider        String          @default("smtp") // "smtp" | "mock" | "console"

  @@index([payrollRunId, status])
  @@index([payrollSlipId])
  @@unique([payrollRunId, employeeId])
}

// ==========================================
// 11. STATUTORY COMPLIANCE & TAX
// ==========================================

model StatutoryConfig {
  id              String          @id @default(uuid())
  companyId       String          @unique
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pfWageCeiling   Decimal         @default(15000) @db.Decimal(18, 2)
  pfEmployeePct   Decimal         @default(12.0) @db.Decimal(5, 2)
  pfEmployerEpfsPct Decimal       @default(3.67) @db.Decimal(5, 2)
  pfEmployerEpsPct Decimal        @default(8.33) @db.Decimal(5, 2)
  esicWageCeiling Decimal         @default(21000) @db.Decimal(18, 2)
  esicEmployeePct Decimal         @default(0.75) @db.Decimal(5, 2)
  esicEmployerPct Decimal         @default(3.25) @db.Decimal(5, 2)
  gratuityPct     Decimal         @default(4.81) @db.Decimal(5, 2)
  updatedAt       DateTime        @updatedAt
}

model ProfessionalTaxSlab {
  id              String          @id @default(uuid())
  state           String
  minSalary       Decimal         @db.Decimal(18, 2)
  maxSalary       Decimal?        @db.Decimal(18, 2)
  monthlyAmount   Decimal         @db.Decimal(18, 2)
  februaryAmount  Decimal?        @db.Decimal(18, 2)

  @@index([state])
}

model EmployeeTaxDeclaration {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  financialYear   String
  regime          String          @default("NEW")
  section80C      Decimal         @default(0) @db.Decimal(18, 2)
  section80D      Decimal         @default(0) @db.Decimal(18, 2)
  section24b      Decimal         @default(0) @db.Decimal(18, 2)
  hraRentPaid     Decimal         @default(0) @db.Decimal(18, 2)
  status          String          @default("SUBMITTED")
  submittedAt     DateTime        @default(now())
}

// ==========================================
// 12. EXPENSES, TRAVEL & TIMESHEETS
// ==========================================

model ExpenseCategory {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  maxLimit        Decimal?        @db.Decimal(18, 2)
  requiresReceipt Boolean         @default(true)
  active          Boolean         @default(true)

  items           ExpenseItem[]

  @@unique([companyId, code])
}

model ExpenseClaim {
  id              String          @id @default(uuid())
  claimNumber     String?
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  claimType       String?         @default("EXPENSE") // 'EXPENSE' | 'REIMBURSEMENT'
  title           String
  claimDate       DateTime
  totalAmount     Decimal         @db.Decimal(18, 2)
  status          RequestStatus   @default(PENDING)
  approvedBy      String?
  actionedAt      DateTime?
  rejectionReason String?
  resubmittedAt   DateTime?
  correctionNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  items           ExpenseItem[]

  @@index([claimNumber])
  @@index([employeeId, status])
  @@index([claimType])
}

model ExpenseItem {
  id              String          @id @default(uuid())
  expenseClaimId  String
  expenseClaim    ExpenseClaim    @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount          Decimal         @db.Decimal(18, 2)
  receiptUrl      String?
  description     String?
}

model TravelRequest {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  purpose         String
  destination     String
  fromDate        DateTime
  toDate          DateTime
  estimatedBudget Decimal         @db.Decimal(18, 2)
  advanceAmount   Decimal         @default(0) @db.Decimal(18, 2)
  status          RequestStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
}

model Project {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  clientName      String?
  status          String          @default("ACTIVE")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())

  allocations     ProjectAllocation[]
  timesheets      TimesheetEntry[]

  @@unique([companyId, code])
}

model ProjectAllocation {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocatedHours  Int             @default(40)

  @@unique([projectId, employeeId])
}

model TimesheetEntry {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  date            DateTime
  hours           Decimal         @db.Decimal(4, 2)
  taskDescription String
  isBillable      Boolean         @default(true)
  status          RequestStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
}

// ==========================================
// 13. PERFORMANCE MANAGEMENT (PMS)
// ==========================================

model PerformanceCycle {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  year            Int
  startDate       DateTime
  endDate         DateTime
  status          String          @default("ACTIVE")
  createdAt       DateTime        @default(now())

  goals           EmployeeGoal[]
  reviews         PerformanceReview[]
}

model EmployeeGoal {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId         String
  cycle           PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  weightage       Int             @default(20)
  targetMetric    String?
  progressPct     Int             @default(0)
  createdAt       DateTime        @default(now())
}

model PerformanceReview {
  id              String          @id @default(uuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId         String
  cycle           PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  selfScore       Int?
  selfComments    String?
  managerScore    Int?
  managerComments String?
  rating          ReviewRating?
  promotionRecommended Boolean    @default(false)
  incrementPct    Decimal?        @db.Decimal(5, 2)
  status          String          @default("SUBMITTED")
  createdAt       DateTime        @default(now())

  @@unique([employeeId, cycleId])
}

// ==========================================
// 14. TRAINING & LEARNING
// ==========================================

model TrainingCourse {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  title           String
  trainerName     String?
  durationHours   Int             @default(8)
  category        String
  createdAt       DateTime        @default(now())

  nominations     TrainingNomination[]

  @@unique([companyId, code])
}

model TrainingNomination {
  id              String          @id @default(uuid())
  courseId        String
  course          TrainingCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status          String          @default("NOMINATED")
  feedback        String?
  createdAt       DateTime        @default(now())

  @@unique([courseId, employeeId])
}

// ==========================================
// 15. LOANS & ADVANCES
// ==========================================

model LoanType {
  id                 String          @id @default(uuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  maxAmount          Decimal         @db.Decimal(18, 2)
  interestRatePct    Decimal         @default(0) @db.Decimal(5, 2)
  maxTenureMonths    Int             @default(12)
  interestType       String          @default("INTEREST_FREE")
  interestMethod     String          @default("FLAT_RATE")
  minInterestRatePct Decimal         @default(0) @db.Decimal(5, 2)
  maxInterestRatePct Decimal         @default(36) @db.Decimal(5, 2)
  allowRateOverride  Boolean         @default(true)
  active             Boolean         @default(true)

  loans              EmployeeLoan[]

  @@unique([companyId, code])
}

model EmployeeLoan {
  id                  String          @id @default(uuid())
  employeeId          String
  employee            Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanTypeId          String
  loanType            LoanType        @relation(fields: [loanTypeId], references: [id])
  principalAmount     Decimal         @db.Decimal(18, 2)
  monthlyEmi          Decimal         @db.Decimal(18, 2)
  tenureMonths        Int
  recoveredAmount     Decimal         @default(0) @db.Decimal(18, 2)
  outstandingAmount   Decimal         @db.Decimal(18, 2)
  status              String          @default("ACTIVE")
  interestType        String          @default("INTEREST_FREE")
  interestRatePct     Decimal         @default(0) @db.Decimal(5, 2)
  interestMethod      String          @default("FLAT_RATE")
  totalInterest       Decimal         @default(0) @db.Decimal(18, 2)
  totalRepayment      Decimal         @default(0) @db.Decimal(18, 2)
  sanctionOrderNumber String?
  repaymentFrequency  String          @default("MONTHLY")
  interestStartDate   DateTime?
  createdAt           DateTime        @default(now())

  repayments          LoanRepayment[]
}

model LoanRepayment {
  id              String          @id @default(uuid())
  loanId          String
  loan            EmployeeLoan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amountPaid      Decimal         @db.Decimal(18, 2)
  paidDate        DateTime        @default(now())
}

// ==========================================
// 16. ASSET MANAGEMENT
// ==========================================

model CompanyAsset {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetTag        String          @unique
  name            String
  category        AssetCategory
  serialNumber    String?
  condition       AssetCondition  @default(NEW)
  createdAt       DateTime        @default(now())

  allocations     AssetAllocation[]
}

model AssetAllocation {
  id              String          @id @default(uuid())
  assetId         String
  asset           CompanyAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocatedAt     DateTime        @default(now())
  returnedAt      DateTime?
  status          String          @default("ALLOCATED")
}

// ==========================================
// 17. HR HELP DESK
// ==========================================

model HelpDeskCategory {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  slaHours        Int             @default(24)
  active          Boolean         @default(true)

  tickets         HelpDeskTicket[]

  @@unique([companyId, name])
}

model HelpDeskTicket {
  id              String          @id @default(uuid())
  ticketNumber    String          @unique
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  categoryId      String
  category        HelpDeskCategory @relation(fields: [categoryId], references: [id])
  priority        TicketPriority  @default(MEDIUM)
  subject         String
  description     String
  status          TicketStatus    @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments        TicketComment[]
}

model TicketComment {
  id              String          @id @default(uuid())
  ticketId        String
  ticket          HelpDeskTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  comment         String
  isInternal      Boolean         @default(false)
  createdAt       DateTime        @default(now())
}

// ==========================================
// 18. OFFBOARDING & FULL-AND-FINAL (F&F)
// ==========================================

model Resignation {
  id              String          @id @default(uuid())
  employeeId      String          @unique
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedAt     DateTime        @default(now())
  requestedLwd    DateTime
  agreedLwd       DateTime?
  reason          String
  status          RequestStatus   @default(PENDING)
  approvedBy      String?
  actionedAt      DateTime?

  fnfSettlement   FnfSettlement?
}

model FnfSettlement {
  id              String          @id @default(uuid())
  employeeId      String          @unique
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resignationId   String          @unique
  resignation     Resignation     @relation(fields: [resignationId], references: [id])
  lastWorkingDay  DateTime
  noticeShortfallDays Int         @default(0)
  noticeRecovery  Decimal         @default(0) @db.Decimal(18, 2)
  leaveEncashment Decimal         @default(0) @db.Decimal(18, 2)
  gratuityAmount  Decimal         @default(0) @db.Decimal(18, 2)
  salaryDue       Decimal         @default(0) @db.Decimal(18, 2)
  loanRecoveryDues Decimal        @default(0) @db.Decimal(18, 2)
  netSettlementPay Decimal        @db.Decimal(18, 2)
  status          String          @default("DRAFT")
  createdAt       DateTime        @default(now())
}

// ==========================================
// 19. VISITOR MANAGEMENT
// ==========================================

model VisitorPass {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  passNumber      String          @unique
  visitorName     String
  visitorPhone    String
  hostName        String
  purpose         String
  scheduledAt     DateTime
  checkInTime     DateTime?
  checkOutTime    DateTime?
  status          String          @default("SCHEDULED")
  createdAt       DateTime        @default(now())
}

// ==========================================
// 20. CUSTOM FIELDS & COLUMN MANAGER
// ==========================================

model CustomFieldDefinition {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module          String      @default("EMPLOYEE")
  fieldKey        String
  fieldLabel      String
  fieldType       String      // TEXT, NUMBER, DATE, DROPDOWN, CHECKBOX, EMAIL
  optionsJson     String?
  isRequired      Boolean     @default(false)
  defaultValue    String?
  isVisible       Boolean     @default(true)
  displayOrder    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  values          EmployeeCustomFieldValue[]

  @@unique([companyId, module, fieldKey])
}

model EmployeeCustomFieldValue {
  id                String                 @id @default(uuid())
  employeeId        String
  employee          Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition  @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  fieldValue        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([employeeId, fieldDefinitionId])
}

// ==========================================
// 21. IN-APP NOTIFICATIONS
// ==========================================

model InAppNotification {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  link        String?
  type        String    @default("EXPENSE_CLAIM")
  entityId    String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isRead])
  @@index([companyId, type])
}
